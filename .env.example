# PostgreSQL: usa una base de datos dedicada para GABOT CLOUD FTTH.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gabot_cloud_ftth?schema=public"

# Genera una clave aleatoria larga (mínimo 32 caracteres). Nunca la subas al repositorio.
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="8h"

# Clave independiente para cifrar credenciales de MikroTik y SmartOLT (no subir secretos reales).
INTEGRATION_ENCRYPTION_KEY="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
API_PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Solo para el primer seed. Introduce estos valores como variables de entorno seguras.
SEED_TENANT_NAME="GABOT CLOUD FTTH"
SEED_TENANT_SLUG="gabot"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS"

# Destinos HTTPS exactos permitidos para evitar solicitudes a hosts no autorizados.
# Formato: host:puerto (sin https://), separados por comas. Mantener vacíos hasta aprobar los destinos.
MIKROTIK_ALLOWED_HOSTS=""
SMARTOLT_ALLOWED_HOSTS=""

# Habilita el laboratorio FTTH ficticio solo en desarrollo local/Codespaces.
# No habilitar en producción. La simulación vive en memoria y no toca equipos reales.
GABOT_DEMO_MODE="true"
