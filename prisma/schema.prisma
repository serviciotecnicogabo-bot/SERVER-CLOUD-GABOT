generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  BILLING
  SUPPORT
  TECHNICIAN
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  DIGITAL_WALLET
  OTHER
}

enum EquipmentVendor {
  HUAWEI
  ZTE
  VSOL
  OTHER
}

enum EquipmentType {
  OLT
  ONT
  ROUTER
  SWITCH
  OTHER
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  customers Customer[]
  plans     Plan[]
  invoices  Invoice[]
  payments  Payment[]
  equipment NetworkEquipment[]
  auditLogs AuditLog[]
  integrationConfig IntegrationConfig?
  paymentNoticeConfig PaymentNoticeConfig?
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Customer {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  document    String?
  email       String?
  phone       String?
  address     String?
  district    String?
  status      CustomerStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  subscriptions Subscription[]
  invoices    Invoice[]
  payments    Payment[]
  portalUser  User?

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, status])
}

model Plan {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  speedDown   Int
  speedUp     Int
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("PEN")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]

  @@unique([tenantId, name])
}

model Subscription {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id])
  startDate   DateTime @default(now())
  endDate     DateTime?
  status      CustomerStatus @default(ACTIVE)
  pppoeUsername String? @unique
  zone        String?
  streetName  String?
  streetNumber String?
  vlanId      Int?
  onuSerial   String?
  oltName     String?
  ponPort     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([customerId, status])
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  number      String
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  subtotal    Decimal       @db.Decimal(10, 2)
  tax         Decimal       @default(0) @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  balance     Decimal       @db.Decimal(10, 2)
  currency    String        @default("PEN")
  status      InvoiceStatus @default(ISSUED)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@index([customerId, dueDate])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("PEN")
  method      PaymentMethod
  reference   String?
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())
  @@index([tenantId, paidAt])
  @@index([customerId, paidAt])
}

model NetworkEquipment {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  vendor      EquipmentVendor
  type        EquipmentType
  model       String?
  managementIp String?
  location    String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@unique([tenantId, name])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([tenantId, createdAt])
}


model IntegrationConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mikrotikBaseUrl      String?
  mikrotikUsername     String?
  mikrotikPasswordEnc  String?
  smartoltBaseUrl      String?
  smartoltApiTokenEnc  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}


model PaymentNoticeConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled              Boolean  @default(true)
  businessName         String?
  logoDataUrl          String?  @db.Text
  qrDataUrl            String?  @db.Text
  message              String   @default("Tu servicio está próximo a vencer. Realiza tu pago para evitar la suspensión.")
  paymentInstructions  String?
  contactPhone         String?
  daysBeforeDue        Int      @default(3)
  reconnectionFee      Decimal  @default(0) @db.Decimal(10, 2)
  currency             String   @default("PEN")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
